# ─────────────────────────────────────────────────────────────
#  Simulateur USSD FinZuu — variables d'environnement
#  Copier en .env et renseigner. Le .env n'est jamais versionné.
#
#  C'est le SEUL endroit du projet où une adresse de service
#  est écrite. Aucun branchement conditionnel ailleurs :
#  la bascule entre environnements est une adresse.
# ─────────────────────────────────────────────────────────────

# Service d'attribution — rend un numéro de client pour sept jours
# Contrat : docs/CONTRAT_ATTRIBUTION.md (figé, v0.3)
ATTRIBUTION_BASE_URL=

# Service USSD — reçoit les saisies, rend les écrans de menu
USSD_BASE_URL=

# Délai d'attente réseau, en millisecondes
REQUEST_TIMEOUT_MS=15000

# LES GUILLEMETS SONT OBLIGATOIRES : dans un fichier .env, `#` ouvre un
# COMMENTAIRE. Sans eux, `*321#` est lu `*321` et le diese part
# SILENCIEUSEMENT — defaut vu le 27/08 sur l'Itel, invisible en test
# unitaire (les tests passent le code en prop, sans traverser le .env).
#
# Code a composer pour ouvrir le menu — AFFICHE a l'usager sur l'ecran de
# composition (demande Direction 27/08 : rien ne lui disait quoi taper).
# Il vit ici et nulle part ailleurs : un code en dur dans un ecran serait un
# mensonge le jour ou l'operateur en change.
CODE_USSD="*321#"
